# Copy this file to ".env" (same folder) and set MONGODB_URI to switch storage from db.json to MongoDB.
# Leave MONGODB_URI out (or delete .env) to keep using server/data/db.json.

# MongoDB installed on this laptop (works without internet):
MONGODB_URI=mongodb://127.0.0.1:27017/potato_den

# MongoDB Atlas (needs internet at the booth). Use the string from Atlas > Connect > Drivers:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/potato_den
